{
  "manifest_version": 3,
  "name": "Anti Fake News",
  "version": "0.1.0",
  "minimum_chrome_version": "102",
  "description": "M\u1edf phi\u00ean ph\u00e2n t\u00edch v\u00e0 tr\u00edch n\u1ed9i dung t\u1eeb tab \u0111ang xem.",
  "action": {
    "default_title": "Ph\u00e2n t\u00edch b\u00e0i vi\u1ebft"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ]
}
