# Copy to .env at repository root. Values below are configuration examples.
AFN_HOST=127.0.0.1
AFN_PORT=8000
# Real/demo is the default. Mock requires BOTH environment=dev/test and mode=mock.
AFN_ENVIRONMENT=demo
AFN_PREDICTOR_MODE=real
# Empty rejects every prediction (401), including mock. Supply a local secret.
AFN_DEMO_TOKEN=
# Set to chrome-extension:// followed by your real 32-character extension ID.
# Stored only; CORS enforcement belongs to #38.
AFN_EXTENSION_ORIGIN=
# Relative paths resolve from repository root. No artifact is loaded in #7/#8.
AFN_MODEL_ARTIFACT_PATH=artifacts/model
# Enforced total body cap, including multipart overhead; default pending review.
AFN_MAX_REQUEST_BYTES=12582912

